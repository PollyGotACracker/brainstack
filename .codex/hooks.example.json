{
  "description": "Inject canonical role and persona files into Codex main and subagent contexts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\" --include-role --default-role buddy",
            "commandWindows": "py \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\" --include-role --default-role buddy",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\" --include-role",
            "commandWindows": "py \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\" --include-role",
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
