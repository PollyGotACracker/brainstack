{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "buddy",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(wc *)",
      "Bash(python tools/check-doc-rule.py)",
      "Bash(python tools/skills.py check)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(rm *)",
      "Bash(rmdir *)"
    ],
    "deny": [
      "Agent(fork)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git clean *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\" --default-role buddy"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<LOAD_AGENT_CONTEXT_SCRIPT_PATH>\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import json; print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'ask', 'permissionDecisionReason': 'Subagent call requires user approval'}}))\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"<STATUSLINE_SCRIPT_PATH>\"",
    "padding": 0
  }
}
